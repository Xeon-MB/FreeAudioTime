<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareCard"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#101D17">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FreeAudioTime"
        android:textColor="#DCE9B0"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="SUA MÚSICA.\nSEUS MOMENTOS."
        android:textColor="#E5EDCF"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sharePeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SEMANA ATUAL"
        android:textColor="#B7C8B0"
        android:textSize="12sp"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:padding="22dp"
        android:orientation="vertical"
        android:background="#244536">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPO DE REPRODUÇÃO"
            android:textColor="#DCE9B0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0min"
            android:textColor="#F4F2DF"
            android:textSize="42sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="20dp"
        android:orientation="vertical"
        android:background="#E5EDCF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARTISTA FAVORITO"
            android:textColor="#52664E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nenhum artista"
            android:textColor="#193D30"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#A8B99A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="MÚSICA MAIS OUVIDA"
            android:textColor="#52664E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nenhuma música"
            android:textColor="#193D30"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="20dp"
        android:orientation="vertical"
        android:background="#39351F">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEUS TOP ARTISTAS"
            android:textColor="#D7C77E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareTopArtists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhum registro"
            android:textColor="#F4F2DF"
            android:textSize="14sp"
            android:lineSpacingExtra="7dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SUAS TOP MÚSICAS"
            android:textColor="#D7C77E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareTopTracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhum registro"
            android:textColor="#F4F2DF"
            android:textSize="14sp"
            android:lineSpacingExtra="7dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="CADA MINUTO CONTA."
        android:textColor="#DCE9B0"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

</LinearLayout>
