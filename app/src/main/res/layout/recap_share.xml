<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareCard"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="#080A08">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FREEAUDIOTIME®"
            android:textColor="#B7FF00"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/shareVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOL. 001"
            android:textColor="#F0EBDD"
            android:textSize="10sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#B7FF00" />

    <TextView
        android:id="@+id/sharePeriod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="YOUR WEEK IN MUSIC"
        android:textColor="#B7FF00"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <!-- TEMPO TOTAL -->
    <LinearLayout
        android:id="@+id/shareTimeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="14dp"
        android:orientation="vertical"
        android:background="#B7FF00">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL LISTENING TIME"
            android:textColor="#080A08"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/shareTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="18H 42MIN"
            android:textColor="#080A08"
            android:textSize="47sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/shareTotalMinutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="/// 1122 MIN"
            android:textColor="#080A08"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ARTISTA E DESCOBERTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/shareArtistImage"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:scaleType="centerCrop"
                android:background="#252823"
                android:contentDescription="Artista mais ouvido" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ARTIST Nº 01"
                android:textColor="#080A08"
                android:background="#B7FF00"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shareArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="LAUFEY"
                android:textColor="#F0EBDD"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/shareArtistTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7H 25MIN"
                android:textColor="#B7FF00"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DISCOVERY + ÍCONES -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- CAIXA DISCOVERY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#111511">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCOVERY"
                    android:textColor="#B7FF00"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shareArtistCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="12"
                    android:textColor="#F0EBDD"
                    android:textSize="37sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARTISTS"
                    android:textColor="#F0EBDD"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="#555B4C" />

            </LinearLayout>

            <!-- ÍCONES ESPALHADOS -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="5dp">

                <ImageView
                    android:id="@+id/iconMusic1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="top|end"
                    android:src="@drawable/disco"
                    android:tint="#E8F0C8"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/iconMusic2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center|start"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/nota"
                    android:tint="#E8F0C8"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/iconMusic3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/onda"
                    android:tint="#E8F0C8"
                    android:scaleType="fitCenter" />

            </FrameLayout>

        </LinearLayout>


    </LinearLayout>



    <!-- OUTROS ARTISTAS DO TOP 3 -->
    <LinearLayout
        android:id="@+id/shareOtherArtists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#111511">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALSO IN ROTATION"
            android:textColor="#B7FF00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

    </LinearLayout>


    <!-- MELHOR DIA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="12dp"
        android:orientation="vertical"
        android:background="#111511">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PEAK DAY / BEST MOMENT"
            android:textColor="#B7FF00"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shareBestDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FRIDAY"
            android:textColor="#F0EBDD"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/shareBestDayTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3H 18MIN"
            android:textColor="#B7FF00"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONQUISTAS DO PERÍODO -->
    <LinearLayout
        android:id="@+id/shareAchievementsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNLOCKED ACHIEVEMENTS"
                android:textColor="#B7FF00"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="#B7FF00" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/shareAchievements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#111511" />

    </LinearLayout>

    <!-- TOP MÚSICAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR TOP TRACKS"
                android:textColor="#B7FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="#B7FF00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP 03"
                android:textColor="#F0EBDD"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/shareTopTracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- CONQUISTAS DO PERÍODO -->
    <LinearLayout
        android:id="@+id/shareAchievementsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNLOCKED ACHIEVEMENTS"
                android:textColor="#B7FF00"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="#B7FF00" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/shareAchievements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#111511" />

    </LinearLayout>

    <!-- RODAPÉ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#B7FF00" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="A PERSONAL MUSIC ARCHIVE"
        android:textColor="#B7FF00"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="EVERY MINUTE HAS A STORY.  //  FAT® 2026"
        android:textColor="#F0EBDD"
        android:textSize="10sp"
        android:letterSpacing="0.08" />

</LinearLayout>
