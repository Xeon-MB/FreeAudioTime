<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:id="@+id/recapScroll">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← VOLTAR"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="SEU RECAP"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Sua música em números."
            android:textColor="@color/text_primary"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weekPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SEMANA ATUAL"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/periodWeek"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="SEMANA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:padding="2dp" />

            <Button
                android:id="@+id/periodMonth"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="MÊS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:padding="2dp" />

            <Button
                android:id="@+id/periodYear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ANO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:padding="2dp" />

        </LinearLayout>

        <!-- Tempo do período -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOCÊ OUVIU"
                android:textColor="@color/accent_soft"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/weeklyTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="0min"
                android:textColor="@color/text_on_dark"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="DE MÚSICA NESTA SEMANA"
                android:textColor="@color/accent_soft"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <!-- Gráfico de atividade -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEU RITMO NA SEMANA"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Minutos ouvidos por dia"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.example.freeaudiotime.DailyActivityChart
                android:id="@+id/dailyActivityChart"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Melhor dia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_yellow"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEU DIA MAIS MUSICAL"
                android:textColor="@color/text_yellow"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/bestDayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="QUARTA-FEIRA"
                android:textColor="@color/text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bestDayTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2h 34min"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bestDayDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Seu dia com mais música nos últimos 7 dias."
                android:textColor="@color/text_yellow"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Comparação semanal -->
        <LinearLayout
            android:id="@+id/weeklyComparison"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EM RELAÇÃO À SEMANA PASSADA"
                android:textColor="@color/accent_soft"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/weeklyDifference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="+24%"
                android:textColor="@color/text_on_dark"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weeklyDifferenceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Você ouviu mais música nesta semana."
                android:textColor="@color/accent_soft"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Esta semana"
                    android:textColor="@color/accent_soft"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/currentWeekTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0min"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Semana passada"
                    android:textColor="@color/accent_soft"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/previousWeekTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0min"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Destaques -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="SEUS DESTAQUES"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_yellow"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARTISTA DA SEMANA"
                android:textColor="@color/text_yellow"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weeklyArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Nenhum artista"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/weeklyArtistImage"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:contentDescription="Foto do artista mais ouvido"
                android:src="@drawable/ic_launcher_foreground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/text_yellow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÚSICA DA SEMANA"
                android:textColor="@color/text_yellow"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weeklyTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Nenhuma música"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Ranking de artistas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 — TOP ARTISTAS"
                android:textColor="@color/accent_soft"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weeklyTopArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Nenhum artista registrado"
                android:textColor="@color/text_on_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="10dp" />

        </LinearLayout>

        <!-- Ranking de músicas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02 — TOP MÚSICAS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weeklyTopTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Nenhuma música registrada"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="10dp" />

        </LinearLayout>

        <Button
            android:id="@+id/exportRecapButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/card_dark"
            android:text="SALVAR RECAP COMO IMAGEM"
            android:textColor="@color/text_on_dark"
            android:textStyle="bold" />

        <!-- Rodapé -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:text="CADA MINUTO CONTA."
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

    </LinearLayout>
</ScrollView>
