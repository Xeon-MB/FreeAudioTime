<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Cabeçalho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FreeAudioTime"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SUA VIDA EM MINUTOS DE MÚSICA"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <!-- Alternar tema -->
        <Button
            android:id="@+id/toggleTheme"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/theme_toggle_background"
            android:text="🌙 Alternar tema"
            android:textColor="@color/theme_toggle_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Painel principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEMPO TOTAL DE REPRODUÇÃO"
                android:textColor="@color/accent_soft"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0h 00min"
                android:textColor="@color/text_on_dark"
                android:textSize="38sp"
                android:textStyle="bold"
                tools:text="14h 37min" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:background="@color/divider_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARTISTA MAIS OUVIDO"
                android:textColor="@color/accent_soft"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mostPlayedArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Nenhum artista"
                android:textColor="@color/text_on_dark"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="Katy Perry" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="MÚSICA MAIS OUVIDA"
                android:textColor="@color/accent_soft"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mostPlayedTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Nenhuma música"
                android:textColor="@color/text_on_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="The One That Got Away - Katy Perry" />

        </LinearLayout>


        <!-- Música atual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_light"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/currentTrackCover"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:contentDescription="Capa da música atual" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOCANDO AGORA"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Nenhuma música"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentTrackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Artista desconhecido"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/currentTrackStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Aguardando reprodução"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <!-- Progresso da música -->
                <ProgressBar
                    android:id="@+id/currentTrackProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/progress_tint"
                    android:progressBackgroundTint="@color/progress_background" />

                <!-- Tempos da música -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentTrackElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/currentTrackRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                </LinearLayout>



            </LinearLayout>

        </LinearLayout>


        <!-- Estatísticas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="SEU RESUMO"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_light"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTA SEMANA"
                    android:textColor="@color/text_yellow"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weeklyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0min"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="14min" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_yellow"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTE MÊS"
                    android:textColor="@color/text_yellow"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monthlyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0min"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="14min" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTE ANO"
                android:textColor="@color/text_yellow"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yearlyTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0min"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="14min" />

        </LinearLayout>

        <!-- Sequência e proteções -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 SUA SEQUÊNCIA"
                android:textColor="@color/accent_soft"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentStreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="0 dias"
                android:textColor="@color/text_on_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bestStreak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recorde: 0 dias"
                android:textColor="@color/text_on_dark"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="@color/divider_color" />

            <TextView
                android:id="@+id/streakProtections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Proteções restantes: 3"
                android:textColor="@color/text_on_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Navegação -->
        <Button
            android:id="@+id/openRecap"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/button_primary"
            android:text="VER MEU RECAP  →"
            android:textColor="@color/button_primary_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/openRecords"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/button_secondary"
            android:text="VER MEUS RECORDES  →"
            android:textColor="@color/button_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Favoritos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="SEUS FAVORITOS"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP 5 ARTISTAS"
                android:textColor="@color/accent_soft"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/topArtists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_on_dark"
                android:textSize="15sp"
                android:lineSpacingExtra="10dp"
                android:text="Nenhum artista registrado" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_light"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP 5 MÚSICAS"
                android:textColor="@color/text_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/topTracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="10dp"
                android:text="Nenhuma música registrada" />

        </LinearLayout>

        <!-- Rodapé -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="CADA MINUTO CONTA."
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

    </LinearLayout>

</ScrollView>